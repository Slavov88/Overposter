# Local development binds to loopback. No hosted identity or compiler is configured.
PORT=4318
OVERPOSTER_WEB_PORT=5173
# OVERPOSTER_DATA=.overposter
# OVERPOSTER_MODE=local
# Hosted mode intentionally fails startup until identity and isolation exist.
# Test harness only: NODE_ENV=test OVERPOSTER_MODE=test-hosted OVERPOSTER_TEST_IDENTITIES=1
# Test identity is the X-Overposter-Test-Subject request header. Never publish this mode.
# Proposed hosted contract only; these variables are not wired in this release:
# OVERPOSTER_PUBLIC_ORIGIN=https://overposter.example.invalid
# OVERPOSTER_ACCOUNTS_ISSUER=https://accounts.example.invalid
# OVERPOSTER_ACCOUNTS_CLIENT_ID=overposter
# OVERPOSTER_ACCOUNTS_CLIENT_SECRET=<supply-from-secret-store>
# OVERPOSTER_SESSION_SECRET=<supply-from-secret-store>
# OVERPOSTER_WORKER_ENDPOINT=https://worker.internal.example.invalid
